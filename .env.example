# LiveKit Cloud Configuration (Primary)
LIVEKIT_CLOUD_URL=wss://your-project.livekit.cloud
LIVEKIT_CLOUD_API_KEY=your_cloud_key
LIVEKIT_CLOUD_API_SECRET=your_cloud_secret

# LiveKit Local Configuration (Fallback/Standby)
LIVEKIT_LOCAL_URL=ws://127.0.0.1:7880
LIVEKIT_LOCAL_API_KEY=devkey
LIVEKIT_LOCAL_API_SECRET=secret

# LLM: Gemini (key rotation: 1 -> 2 -> 3 on 429)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# TTS: Fish Audio
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
FISH_AUDIO_REFERENCE_ID=optional_voice_clone_reference_id
